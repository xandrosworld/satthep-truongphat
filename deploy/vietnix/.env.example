# Copy to .env on the VPS. Never commit the populated file.
TP_DOMAIN=truongphat-group.xyz
# Generate with: openssl rand -hex 32
TP_SETUP_KEY=
TP_RELEASE=local
TP_DATA_DIR=/srv/truongphat/data
TP_BACKUP_DIR=/srv/truongphat/backups
# Keep the current provider key/model; migration does not change AI pricing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
